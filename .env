APP_NAME="Biblioteca Barrial"
APP_ENV=local
APP_KEY=base64:AEYTiUX5WQO8ThM8khjzsgDLaABVwuyzSc5EqPRSQGU=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Base de datos (usa el nombre del servicio de docker-compose, no 127.0.0.1) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=biblioteca_barrial
DB_USERNAME=biblioteca
DB_PASSWORD=secret

# --- Sanctum: dominios de las interfaces que consumen la API por cookie/sesión ---
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:5173,localhost:8080,localhost:5174
SESSION_DOMAIN=localhost

# --- UID/GID para que los archivos creados dentro del contenedor sean tuyos ---
UID=1000
GID=1000
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
